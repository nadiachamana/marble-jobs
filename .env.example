# ─────────────────────────────────────────────────────────────
# Marble Job Board Automation — environment configuration
# Copy to `.env` and fill in. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────

# --- App ---
# Public base URL the review dashboard is reachable at (used in Slack/email links).
APP_BASE_URL=http://localhost:8000
# Dev: sqlite. Prod (Railway): set DATABASE_URL to the Postgres connection string.
DATABASE_URL=sqlite:///./data/marble.db
# Optional: lets the LOCAL assisted-posting tool (app/assist.py) read real jobs
# from the Railway Postgres while the rest of local dev stays on SQLite.
# ASSIST_DATABASE_URL=postgresql://postgres:<password>@<host>.proxy.rlwy.net:<port>/railway

# --- Ashby ---
# API key with jobsRead permission. Used to call jobPosting.info.
ASHBY_API_KEY=
# Shared secret configured on the Ashby webhook, used to verify Ashby-Signature (HMAC-SHA256).
ASHBY_WEBHOOK_SECRET=
# Base of the public Ashby job board (used as a fallback for UTM tracker URLs).
ASHBY_JOB_BOARD_BASE=https://jobs.ashbyhq.com/marble

# --- Slack ---
# Bot token (xoxb-…) — REQUIRED for threaded status updates (chat.postMessage).
# Create a Slack app, add the `chat:write` scope, install to the workspace, copy
# the Bot User OAuth Token, and invite the bot to the channel (/invite @YourBot).
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#talent-ops
# Incoming webhook URL — fallback only; cannot thread. Leave set or blank.
SLACK_WEBHOOK_URL=

# --- Email notifications (review alerts) ---
NOTIFY_EMAIL_TO=nadia@marble.studio
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hiring@marble.studio

# --- Marble constants used when filling boards ---
MARBLE_CONTACT_EMAIL=hiring@marble.studio
MARBLE_CONTACT_NAME=Nadia Chamana
MARBLE_CONTACT_PHONE=+33749945048

# --- Board credentials (Playwright authenticated boards) ---
# One pair per board, keyed by the board's credentials_ref (see board_config).
# Format: BOARD_<CREDREF_UPPER_SNAKE>_USERNAME / _PASSWORD
# Example for credentials_ref "ku-leuven":
# BOARD_KU_LEUVEN_USERNAME=hiring@marble.studio
# BOARD_KU_LEUVEN_PASSWORD=...
